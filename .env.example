# Copy this file to .env and fill in values for your environment.
# Priority: CLI arguments > exported environment variables > .env > script defaults

DATAEASE_BASE_URL=https://your-dataease.example.com
DATAEASE_ACCESS_KEY=
DATAEASE_SECRET_KEY=
DATAEASE_USERNAME=
DATAEASE_PASSWORD=
DATAEASE_LOGIN_ORIGIN=0
DATAEASE_REQUEST_MODE=auto

# Screenshot output directory - set to OpenClaw workspace for MEDIA: display
# Default: <skill_dir>/output (outside workspace, images won't render in chat)
# Recommended: <workspace>/dataease-output
DATAEASE_OUTPUT_DIR=
