# Copy this file to .env and fill in values for your environment.
# Priority: CLI arguments > exported environment variables > .env > script defaults

DATAEASE_BASE_URL=https://your-dataease.example.com
DATAEASE_ACCESS_KEY=
DATAEASE_SECRET_KEY=
DATAEASE_USERNAME=
DATAEASE_PASSWORD=
DATAEASE_LOGIN_ORIGIN=0
DATAEASE_REQUEST_MODE=auto
DATAEASE_PROXY_MODE=auto
DATAEASE_NO_PROXY=
DATAEASE_ORG_ID=
DATAEASE_X_DE_TOKEN=

# Transport and runtime
DATAEASE_TIMEOUT=30
DATAEASE_VERIFY_SSL=true
DATAEASE_CA_BUNDLE=
DATAEASE_ALLOW_UNVERIFIED_VERSION=false
DATAEASE_OUTPUT_DIR=
DATAEASE_CANVAS_TIMEOUT_MS=120000

# Visualization
DATAEASE_THEME=business-light
DATAEASE_BACKGROUND_IMAGE=
DATAEASE_CHECK_VERSION=

# Proxy modes: auto bypasses local/private targets, environment always honors
# HTTP_PROXY/HTTPS_PROXY, and direct never uses environment proxies.
